# ── Base de datos ─────────────────────────────────────────────────────────────
# Si defines DATABASE_URL se usa PostgreSQL (docker compose up levanta uno en dev).
# Si la dejas vacía o sin definir, se usa PGlite: un PostgreSQL embebido que
# guarda los datos en ./data/pglite — perfecto para dev sin Docker.
# DATABASE_URL=postgres://biziye:biziye@localhost:5432/biziye
# Dónde guarda PGlite sus datos. Si el proyecto vive en una carpeta
# sincronizada (OneDrive/Dropbox), apunta esto FUERA de ella: la sincronización
# bloquea archivos y puede corromper la BD embebida.
# PGLITE_DIR=C:\Users\tuusuario\AppData\Local\biziye\pglite

# ── IA ────────────────────────────────────────────────────────────────────────
# Proveedor: mock | openai | bridge
IA_PROVEEDOR=mock
# Solo para IA_PROVEEDOR=openai
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini
# Solo para IA_PROVEEDOR=bridge (ver docs/bridge.md)
BRIDGE_URL=
BRIDGE_TOKEN=

# ── Notificaciones Web Push ───────────────────────────────────────────────────
# Genera las claves con: npm run generar-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.es

# ── App ───────────────────────────────────────────────────────────────────────
# Zona horaria de la app (cálculo de días, recordatorios…)
TZ_APP=Europe/Madrid
# 'true' cuando sirvas por HTTPS (prod). En local déjalo en false.
COOKIE_SEGURA=false
# Origen público (prod), lo usa SvelteKit para formularios: https://biziye.tudominio.es
# ORIGIN=
